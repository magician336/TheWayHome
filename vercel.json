{
    "version": 2,
    "cleanUrls": true,
    "rewrites": [
        {
            "source": "/",
            "destination": "/src/index.html"
        },
        {
            "source": "/index.html",
            "destination": "/src/index.html"
        }
    ],
    "routes": [
        {
            "handle": "filesystem"
        },
        {
            "src": "/(.*)",
            "dest": "/src/$1"
        }
    ]
}